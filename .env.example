# 相对 prisma/schema.prisma；须与运行时 data/town.sqlite 一致（勿用 file:./data/…，会落到 prisma/data/）
DATABASE_URL="file:../data/town.sqlite"
JWT_SECRET=dev-only-change-in-production
PORT=3001
# 小程序头像等静态资源对外访问的根地址（无末尾斜杠），不设置则从请求 Host 推导（本地联调可留空）
# PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGIN=http://localhost:5174