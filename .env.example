# ---------- 本地开发（npm run dev）----------
# 相对 prisma/schema.prisma；须与运行时 data/town.sqlite 一致（勿用 file:./data/…，会落到 prisma/data/）
DATABASE_URL="file:../data/town.sqlite"

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# 生产必须改为随机长字符串（≥32 字符）
JWT_SECRET=dev-only-change-in-production

# 管理端 / 小程序 H5 来源，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5174

# 上传文件、头像对外 URL 前缀（无末尾斜杠）；Docker/反代后建议设为公网 API 地址
# 不设置则从请求 Host / X-Forwarded-Proto 推导（适合本机联调）
# PUBLIC_BASE_URL=https://api.example.com

# ---------- Docker / 阿里云 compose 部署 ----------
# docker-compose.yml 会覆盖 DATABASE_URL 为 file:/app/data/town.sqlite，并挂载卷 town_data、town_uploads
# 部署前复制本文件为 .env，至少修改 JWT_SECRET、CORS_ORIGIN、PUBLIC_BASE_URL